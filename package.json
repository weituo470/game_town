{
  "name": "game-town",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "start": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "node --test tests/*.test.js",
    "check:readability": "node scripts/check-readability.mjs",
    "test:ci": "node --test --test-concurrency=1 tests/*.test.js",
    "check:opensource": "node scripts/check-opensource.mjs",
    "check:loading": "node scripts/check-loading-budget.mjs"
  },
  "dependencies": {
    "@colyseus/core": "0.18.19",
    "@colyseus/schema": "5.0.40",
    "@colyseus/sdk": "0.18.5",
    "@colyseus/ws-transport": "0.18.4",
    "@react-three/drei": "^10.7.0",
    "@react-three/fiber": "^9.3.0",
    "lucide-react": "^0.468.0",
    "mediabunny": "1.61.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sharp": "0.35.5",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.3",
    "vite": "^7.1.7"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24.13.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/weituo470/game_town.git"
  }
