# Safe defaults. npm scripts do not auto-load this file.
# Copy to .env, then: node --env-file=.env scripts/dev.mjs
HOST=127.0.0.1
PORT=2567
GUEST_SECRET=
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173
TRUST_PROXY_LOOPBACK=false

# Optional paid NPC services: disabled, keys empty.
NPC_LLM_ENABLED=false
NPC_LLM_API_KEY=
NPC_LLM_BASE_URL=https://api.deepseek.com/v1
NPC_LLM_MODEL=deepseek-flash
NPC_LLM_TIMEOUT_MS=20000
NPC_LLM_MAX_TOKENS=320
# NPC limit 0 means UNLIMITED, not disabled.
NPC_LLM_DAILY_LIMIT=500
NPC_TTS_ENABLED=false
NPC_TTS_API_KEY=
NPC_TTS_RESOURCE_ID=seed-tts-2.0
NPC_TTS_TIMEOUT_MS=30000
NPC_TTS_DAILY_LIMIT=500

# External image bridge is not bundled. Budget 0 disables new jobs.
GAME_IMAGE_ENABLED=false
GAME_IMAGE_DAILY_BUDGET=0
GAME_IMAGE_OWNER_DAILY_BUDGET=2
GAME_IMAGE_BRIDGE_URL=http://127.0.0.1:8794/v1/images/edits
GAME_IMAGE_BRIDGE_TOKEN_FILE=

# Optional paid 3D service. Both budgets default to zero.
GAME_CHARACTER_ENABLED=false
GAME_CHARACTER_TOTAL_BUDGET=0
GAME_CHARACTER_CREDIT_BUDGET=0
MESHY_API_KEY=

# Optional paid AI drone director: disabled by default, shares NPC LLM config.
# Requires AI_DRONE_ENABLED=true AND NPC_LLM_ENABLED=true with your private key.
AI_DRONE_ENABLED=false
AI_DRONE_DB=.data/ai-drone.sqlite
# Positive integers; 0 does NOT mean unlimited. Resets at Beijing midnight.
AI_DRONE_DAILY_LIMIT=5
AI_DRONE_IP_MINUTE_LIMIT=3
AI_DRONE_IP_DAILY_LIMIT=30
